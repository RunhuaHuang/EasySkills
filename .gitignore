.DS_Store
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
__pycache__/
*.pyc
.playwright-mcp/
.context/

# User-specific custom target paths (generated at runtime)
/custom-targets.txt
_maintenance/custom-targets.txt

# User-specific disabled (unmapped) targets (generated at runtime)
_maintenance/disabled-targets.txt

# Per-machine WebUI auth secret — must NEVER be committed
_maintenance/.easyskills-token
_maintenance/.easyskills-token.lock

# Per-machine rule sync metadata (kept out of Agent instruction context)
/.easyskills-instruction-state.json

# Per-machine Agent skills/instructions path overrides
/.easyskills-agent-paths.json

# User MCP configuration and backups (may contain plaintext credentials)
/mcp/servers.json
/mcp/servers.json.bak

# Lock files (both the legacy file and the current mkdir-based dir lock)
_maintenance/.deploy.lock
_maintenance/.deploy.lock.d/
_maintenance/.webui-service.lock.d/

# Runtime logs (generated by Windows supervisors)
_maintenance/logs/

# Locally built MCP Gateway binaries
_maintenance/bin/
gateway/dist/
/_runtime/

# Self-update backup directory (generated at runtime)
_maintenance.bak/

# Stray patch/working artifacts
/diff.patch

# IDE / agent working directories
.zcode/
