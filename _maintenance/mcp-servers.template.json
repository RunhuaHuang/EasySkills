{
  "version": 1,
  "servers": {
    "prismstudio": {
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "prismstudio@latest"
      ]
    },
    "visionpower": {
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "--package",
        "visionpower@latest",
        "visionpower"
      ]
    }
  },
  "profiles": {
    "default": {
      "servers": [
        "*"
      ]
    }
  }
}
